# 부스 시연 스택 하나. mr-booth.target이 다섯 개(follow, phone_bridge, mission, telemetry, pad)를 띄운다.
# scripts/robot.sh install이 /etc/systemd/system/에 넣는다.
[Unit]
Description=부스 시연 스택 %i
PartOf=mr-booth.target
# 끌 때는 띄운 순서의 반대다. 임무·폰 브리지가 follow(베이스)보다 먼저 내려가 추종을 끄고 나서 베이스가 내려간다.
# follow 자신에게 붙은 자기 참조는 systemd가 버린다.
# chronyc waitsync(stack.sh)가 데몬에 붙을 수 있게 chrony 뒤에 띄운다.
After=mr-booth@follow.service bluetooth.service chrony.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=emjdpi
ExecStart=/home/emjdpi/booth/stack.sh %i
# INT는 ros2 launch에만 보내고 launch가 노드를 차례로 내린다. 시간 안에 안 죽은 것은 cgroup 전체에 KILL.
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=12
Restart=on-failure
RestartSec=3
SyslogIdentifier=booth-%i
